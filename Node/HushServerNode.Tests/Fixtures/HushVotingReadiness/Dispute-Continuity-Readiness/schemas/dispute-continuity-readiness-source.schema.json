  "properties": {
    "schemaVersion": { "const": "dispute-continuity-readiness-source.v1" },
    "featureId": { "const": "FEAT-139" },
    "acceptanceGate": { "const": "AT-RDY-011" },
    "scenarioDecisions": { "type": "array", "minItems": 1 }
  }
}
