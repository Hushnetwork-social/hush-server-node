{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pilot-evidence-package-manifest.schema.json",
  "title": "Pilot Evidence Package Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestId",
    "packageId",
    "generatedAt",
    "artifactHashes"
