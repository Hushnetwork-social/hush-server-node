{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dispute-continuity-readiness-source.schema.json",
  "title": "Dispute Continuity Readiness Source",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceId",
    "featureId",
    "acceptanceGate",
    "sourceGap",
    "status",
    "generatedAt",
