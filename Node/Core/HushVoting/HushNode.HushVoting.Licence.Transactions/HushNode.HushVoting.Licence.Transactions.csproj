<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Shared\HushShared.Blockchain.TransactionModel\HushShared.Blockchain.TransactionModel.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\HushShared.Blockchain.Model\HushShared.Blockchain.Model.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\HushShared.HushVoting.Licensing.Model\HushShared.HushVoting.Licensing.Model.csproj" />
    <!-- Approved FEAT-001 signature-encoding classifier/contracts (compact base64 r||s and the
         explicitly Approved historical DER hex). Shared model only; never a Core dependency. -->
    <ProjectReference Include="..\..\..\..\Shared\HushShared.Identity.Model\HushShared.Identity.Model.csproj" />
    <!-- DB-backed per-identity pending reservation entity + EF projection reader (D4). The
         transactions module mirrors FullIdentity admission which references its storage module. -->
    <ProjectReference Include="..\HushNode.HushVoting.Licensing.Storage\HushNode.HushVoting.Licensing.Storage.csproj" />
    <!-- Additive block-context index seam (D6): index strategies receive block index + time. -->
    <ProjectReference Include="..\..\Indexing\HushNode.Indexing.Interfaces\HushNode.Indexing.Interfaces.csproj" />
    <!-- Block-producer credential signing for the licence content handler (mirrors FullIdentity). -->
    <ProjectReference Include="..\..\..\Infrastructure\HushNode.Credentials\HushNode.Credentials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pins unify transitive EF Core references (Npgsql/Storage resolve lower otherwise). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Npgsql" Version="10.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
